<Window x:Class="Codenotch.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codenotch notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">

  <!-- [ callout (hidden until hover) ][ dials column ] flush to the right edge, the
       same shape as .cn-notch in the GNOME stylesheet. AllowsTransparency rules out
       a DWM backdrop, so the pill is painted by WPF. -->
  <Border x:Name="Pill"
          CornerRadius="18,0,0,18"
          BorderThickness="1,1,0,1"
          SnapsToDevicePixels="True">
    <StackPanel Orientation="Horizontal">
      <Border x:Name="Callout"
              Padding="16,12,6,12"
              BorderThickness="0,0,1,0"
              Visibility="Collapsed"
              Opacity="0">
        <StackPanel x:Name="CalloutBody" />
      </Border>
      <StackPanel x:Name="Dials" Margin="9,12,8,10" />
    </StackPanel>
  </Border>
</Window>
