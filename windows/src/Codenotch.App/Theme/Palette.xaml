<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Every brush here is mutated in place by ToneBrushes on a theme change, so
       bindings update without rebuilding the dictionary. The values below are the
       dark theme (the GNOME stylesheet's exact tones); light is applied at startup
       when the system asks for it. -->

  <!-- usage tones -->
  <SolidColorBrush x:Key="ToneOkBrush" Color="#57E389" />
  <SolidColorBrush x:Key="ToneWarnBrush" Color="#F8E45C" />
  <SolidColorBrush x:Key="ToneCriticalBrush" Color="#FF7B63" />
  <SolidColorBrush x:Key="ToneStaleBrush" Color="#9A9996" />

  <!-- ring and bar track: rgba(255,255,255,.12) -->
  <SolidColorBrush x:Key="TrackBrush" Color="#1FFFFFFF" />

  <!-- text -->
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#9A9996" />
  <SolidColorBrush x:Key="GlyphBrush" Color="#EBFFFFFF" />

  <!-- surfaces: the notch pill and the flyout fallback when Mica is unavailable -->
  <SolidColorBrush x:Key="NotchBrush" Color="#E60C0C0E" />
  <SolidColorBrush x:Key="NotchOpenBrush" Color="#F50C0C0E" />
  <SolidColorBrush x:Key="NotchBorderBrush" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#F21C1C1E" />

</ResourceDictionary>
